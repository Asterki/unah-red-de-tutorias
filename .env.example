# Production compose configuration. Copy to `.env` and replace every
# placeholder before running `docker compose -f compose.prod.yaml up -d`.
# Never commit the real `.env`.

# Runtime
NODE_ENV=production
PORT=3000
SERVICE_NAME=unah-red-tutores-api
SERVE_CLIENT=false
CLIENT_DIR=client-dist
DOCS_DIR=docs/in-app

# Database. In production create a DDL user for migrations and point
# MIGRATE_DATABASE_URL at it; it may fall back to DATABASE_URL.
DATABASE_URL=mysql://app_runtime:change-me@mariadb:3306/app
MIGRATE_DATABASE_URL=mysql://app_runtime:change-me@mariadb:3306/app
DB_POOL_LIMIT=10

# MariaDB container
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=app
MYSQL_USER=app_runtime
MYSQL_PASSWORD=change-me

# Security
SESSION_SECRET=change-me-change-me-change-me-change-me
CORS_ORIGINS=https://your-app.vercel.app
TRUST_PROXY=1
ORIGIN_SECRET=change-me-origin-secret
COOKIE_DOMAIN=

# Logging and tracing
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=unah-red-tutores-api

# Bootstrap (first run only). Leave the password empty to print a one-time
# generated password to stdout; the account must change it after first login.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
