# Runtime
NODE_ENV=development
PORT=3000
SERVICE_NAME=unah-red-tutores-api
SERVE_CLIENT=false
CLIENT_DIR=client-dist
DOCS_DIR=docs/in-app

# Database
DATABASE_URL=mysql://app_runtime:change-me@localhost:3306/app
MIGRATE_DATABASE_URL=mysql://app_migrate:change-me@localhost:3306/app
DB_POOL_LIMIT=10

# MariaDB container (compose.dev.yaml reads these from this file)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=app
MYSQL_USER=app_runtime
MYSQL_PASSWORD=change-me

# Security
SESSION_SECRET=change-me-change-me-change-me-change-me
CORS_ORIGINS=http://localhost:2173
TRUST_PROXY=0
ORIGIN_SECRET=
COOKIE_DOMAIN=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=unah-red-tutores-api

# Bootstrap (first run only). Leave the password empty to print a one-time
# generated password to stdout; the account must change it after first login.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Soft delete. HMAC key used to replace unique values of soft-deleted rows
# (email, identifier, campus/course codes) so the original can be reused.
# Defaults to SESSION_SECRET when empty; set a separate 32+ character value in
# production and keep it stable, because it is one-way.
SOFT_DELETE_HASH_KEY=

# Federated login (optional). A provider is enabled only when every variable
# for that provider is set. The app boots normally with none configured.
#
# Public base URL used to build OAuth callback URLs. In production this is the
# Vercel-facing HTTPS origin, not the internal API host.
AUTH_CALLBACK_BASE_URL=http://localhost:3000
# Client paths the API redirects to after a federated login.
AUTH_SUCCESS_REDIRECT=/
AUTH_FAILURE_REDIRECT=/auth/login

# Microsoft (employees and students). Supported account type: multi-tenant.
# MICROSOFT_ALLOWED_TENANT_IDS is a comma-separated allowlist of Entra tenant
# IDs; empty entries are ignored.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_ALLOWED_TENANT_IDS=

# Google (applicants).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple (applicants). APPLE_CLIENT_ID is the Services ID, not the App ID.
# APPLE_PRIVATE_KEY accepts newline-escaped PEM content ("\n"). Alternatively
# point APPLE_PRIVATE_KEY_PATH at a readable .p8 file (do not commit it).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=

