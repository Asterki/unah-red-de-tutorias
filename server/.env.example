# Runtime
NODE_ENV=development
PORT=3000
SERVICE_NAME=unah-red-tutores-api
SERVE_CLIENT=false
CLIENT_DIR=client-dist
DOCS_DIR=docs/in-app

# Database
DATABASE_URL=mysql://app_runtime:change-me@localhost:3306/app
MIGRATE_DATABASE_URL=mysql://app_migrate:change-me@localhost:3306/app
DB_POOL_LIMIT=10

# MariaDB container (compose.dev.yaml reads these from this file)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=app
MYSQL_USER=app_runtime
MYSQL_PASSWORD=change-me

# Security
SESSION_SECRET=change-me-change-me-change-me-change-me
CORS_ORIGINS=http://localhost:2173
TRUST_PROXY=0
ORIGIN_SECRET=
COOKIE_DOMAIN=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=unah-red-tutores-api

# Bootstrap (first run only). Leave the password empty to print a one-time
# generated password to stdout; the account must change it after first login.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
