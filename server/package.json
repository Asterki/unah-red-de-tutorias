{
  "name": "@unah-red-tutores/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Asterki",
  "repository": {
    "type": "git",
    "url": "https://github.com/Asterki/template-crud-mariadb-rbac"
  },
  "homepage": "https://github.com/Asterki/template-crud-mariadb-rbac#readme",
  "bugs": {
    "url": "https://github.com/Asterki/template-crud-mariadb-rbac/issues"
  },
  "main": "./dist/index.js",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "nodemon --config nodemon.json",
    "build": "tsup",
    "bundle": "tsup",
    "start": "cross-env NODE_ENV=production node ./dist/main.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "tsx src/cli/seed.ts",
    "db:seed:prod": "node dist/cli/seed.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "knip": "knip --no-exit-code"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@quixo3/prisma-session-store": "^3.1.19",
    "@unah-red-tutores/shared": "file:../shared",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^26.6.5",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "knip": "^6.43.0",
    "module-alias": "^2.2.3",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.44.0"
  }
}
