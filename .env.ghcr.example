# Pull-only GHCR deployment. Copy to `.env` and replace every placeholder.
# Never commit the real `.env`.

# Image
GHCR_OWNER=your-github-user-or-org
IMAGE_NAME=unah-red-tutores-api
IMAGE_TAG=latest

# Runtime
PORT=3000

# Database
DATABASE_URL=mysql://app_runtime:change-me@mariadb:3306/app
MIGRATE_DATABASE_URL=mysql://app_runtime:change-me@mariadb:3306/app
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=app
MYSQL_USER=app_runtime
MYSQL_PASSWORD=change-me

# Security
SESSION_SECRET=change-me-change-me-change-me-change-me
CORS_ORIGINS=https://your-app.vercel.app
ORIGIN_SECRET=change-me-origin-secret

# Bootstrap (first run only)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
